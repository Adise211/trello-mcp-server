{
  "name": "trello-mcp-server",
  "version": "1.0.0",
  "description": "Trello MCP Server",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:remote:prod": "NODE_ENV=production node dist/remote/index.js",
    "test": "vitest",
    "dev": "nodemon src/index.ts",
    "remote": "nodemon src/remote/index.ts",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "inspect": "npx @modelcontextprotocol/inspector"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "trello",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.15.0",
    "@types/node": "^20.10.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/validator": "^13.15.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "msw": "^2.11.3",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "@stytch/vanilla-js": "^5.37.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "sanitize-html": "^2.17.0",
    "stytch": "^12.39.0",
    "validator": "^13.15.15",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
